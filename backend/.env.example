ENV=dev
DATABASE_URL=postgresql+asyncpg://recall:recall@localhost:5432/recall
# Without Docker: DATABASE_URL=sqlite+aiosqlite:///./dev.db
SECRET=change-me-to-a-long-random-string
# Public URL of the app, used in email links
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false

# console prints emails to the terminal; smtp sends them (Gmail by default)
EMAIL_BACKEND=console
EMAIL_FROM=Recall <you@gmail.com>
SMTP_USERNAME=you@gmail.com
# A Gmail app password (Google Account > Security > App passwords), not your normal password
SMTP_PASSWORD=
# Optional alternative: EMAIL_BACKEND=resend with a verified domain
RESEND_API_KEY=
