ENV=dev
DATABASE_URL=postgresql+asyncpg://recall:recall@localhost:5432/recall
# Without Docker: DATABASE_URL=sqlite+aiosqlite:///./dev.db
SECRET=change-me-to-a-long-random-string
# Public URL of the app, used in email links
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false

# console prints emails to the terminal; resend sends them for real
EMAIL_BACKEND=console
EMAIL_FROM=Recall <reminders@example.com>
RESEND_API_KEY=
